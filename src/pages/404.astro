---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina no encontrada - CineCerca">
  <div class="container page">
    <div class="notfound">
      <span class="notfound__code">404</span>
      <span class="eyebrow eyebrow--accent">Reel perdido</span>
      <h1 class="notfound__title">Esta funcion <em>ya termino</em>.</h1>
      <p class="text-muted notfound__lead">El link que seguiste no existe o se movio. Volve al lobby y elegi otra pelicula.</p>
      <a class="btn btn-primary" href="/">Volver al inicio</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 5rem 1rem 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .notfound__code {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(7rem, 18vw, 14rem);
    font-weight: 500;
    color: var(--color-primary);
    line-height: 0.85;
    letter-spacing: -0.05em;
    margin-bottom: 0.5rem;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }

  .notfound__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.025em;
    margin: 0.5rem 0;
  }

  .notfound__title em {
    color: var(--color-primary);
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }

  .notfound__lead {
    max-width: 42ch;
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.55;
  }
</style>

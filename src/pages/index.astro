---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import Loader from '../components/Loader.astro';
---

<BaseLayout title="CineCerca - Busca peliculas en cines cercanos">
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__content">
      <span class="hero__eyebrow reveal" style="animation-delay: 40ms">
        <span class="hero__pulse"></span>
        <span class="hero__eyebrow-text">N°042 &middot; Cartelera de la semana</span>
      </span>
      <h1 class="hero__title reveal" style="animation-delay: 120ms">
        Encontra<br />
        <span class="hero__title-accent">la pelicula</span>
        <br />
        cerca tuyo.
      </h1>
      <p class="hero__subtitle reveal" style="animation-delay: 260ms">
        Buscas un titulo, elegimos los cines de tu zona. Horarios, formato e idioma — sin algoritmos turbios.
      </p>
      <div class="hero__search reveal" style="animation-delay: 360ms">
        <SearchBar autofocus />
      </div>
      <ul class="hero__badges reveal" style="animation-delay: 460ms" aria-label="Caracteristicas">
        <li><span class="hero__badge-num">42</span> cines en Argentina</li>
        <li><span class="hero__badge-num">∞</span> peliculas via TMDB</li>
        <li><span class="hero__badge-num">0</span> tracking ni ads</li>
      </ul>
    </div>
  </section>

  <section class="trending container" id="trending">
    <header class="section-head">
      <div>
        <span class="eyebrow eyebrow--accent">01 &mdash; En tendencia</span>
        <h2 class="section-title">Lo mas visto esta semana.</h2>
      </div>
      <a class="section-action" href="/buscar">Ver todas <span aria-hidden="true">→</span></a>
    </header>
    <div id="trending-slot">
      <Loader label="Cargando tendencias..." />
    </div>
  </section>

  <section class="how-it-works container">
    <header class="section-head section-head--center">
      <span class="eyebrow eyebrow--accent">02 &mdash; Como funciona</span>
      <h2 class="section-title">En tres pasos estas <em>en el cine</em>.</h2>
    </header>
    <ol class="steps">
      <li class="step">
        <span class="step__num">01</span>
        <h3 class="step__title">Busca el titulo</h3>
        <p class="step__desc">Resultados en tiempo real desde TMDB. Cero menus innecesarios.</p>
      </li>
      <li class="step">
        <span class="step__num">02</span>
        <h3 class="step__title">Elegi tu zona</h3>
        <p class="step__desc">Selecciona tu zona o activa la geolocalizacion para ordenar por cercania.</p>
      </li>
      <li class="step">
        <span class="step__num">03</span>
        <h3 class="step__title">Mira los horarios</h3>
        <p class="step__desc">Filtra por formato, idioma, precio y franja. Despues solo queda comprar pochoclos.</p>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 40% at 50% 0%, var(--color-primary-soft), transparent 65%),
      radial-gradient(ellipse 50% 30% at 85% 80%, var(--color-accent-soft), transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 900px;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .hero__eyebrow-text { white-space: nowrap; }

  .hero__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    box-shadow: 0 0 0 0 rgba(229, 37, 45, 0.5);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(229, 37, 45, 0.5); }
    70% { box-shadow: 0 0 0 10px rgba(229, 37, 45, 0); }
    100% { box-shadow: 0 0 0 0 rgba(229, 37, 45, 0); }
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 9vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin: 0;
    color: var(--color-text);
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
  }

  .hero__title-accent {
    color: var(--color-primary);
    font-style: italic;
    font-weight: 400;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }

  .hero__subtitle {
    color: var(--color-text-soft);
    max-width: 540px;
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.55;
  }

  .hero__search {
    width: 100%;
    max-width: 640px;
    margin-top: 1rem;
  }

  .hero__badges {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    align-items: baseline;
  }

  .hero__badges li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .hero__badge-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.65rem;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }

  /* Section heading shared */
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-head--center {
    justify-content: center;
    text-align: center;
    border-bottom: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .section-title {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-primary);
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }

  .section-action {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: color var(--transition-fast), gap var(--transition-fast);
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

  .section-action:hover {
    color: var(--color-primary);
    gap: 0.7rem;
  }

  .trending { padding: 3rem 0 4rem; }
  .how-it-works { padding: 4rem 0 6rem; }

  .steps {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--color-border);
    }
    .steps .step + .step {
      border-left: 1px solid var(--color-border);
      border-top: none;
    }
  }

  .step {
    position: relative;
    padding: 2.25rem 1.5rem 1.75rem;
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);
  }

  @media (min-width: 768px) {
    .step { border-bottom: none; }
  }

  .step:hover {
    background-color: var(--color-bg-elevated);
  }

  .step__num {
    display: inline-block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: 0.8rem;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }

  .step__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .step__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>

<script>
  import { getTrending, getPosterUrl } from '../scripts/api.js';
  import { formatYear, formatRating } from '../utils/formatters.js';
  import { isFavorite, toggleFavorite } from '../scripts/favorites.js';

  const slot = document.getElementById('trending-slot');

  function renderError(msg) {
    slot.innerHTML = `
      <div class="error-inline">
        <p>⚠️ ${msg}</p>
        <button class="btn btn-ghost" onclick="location.reload()">Reintentar</button>
      </div>`;
  }

  function renderMovies(movies) {
    const grid = document.createElement('div');
    grid.className = 'movie-grid';
    grid.innerHTML = movies.map((m) => `
      <article class="movie-card" data-id="${m.id}">
        <a href="/pelicula?id=${m.id}" class="movie-card__link">
          <div class="movie-card__poster">
            <img src="${getPosterUrl(m.poster_path, 'w342')}" alt="Poster de ${m.title}" loading="lazy" />
            ${m.vote_average ? `<span class="movie-card__rating">⭐ ${formatRating(m.vote_average)}</span>` : ''}
          </div>
          <div class="movie-card__body">
            <h3 class="movie-card__title">${m.title}</h3>
            <p class="movie-card__year">${formatYear(m.release_date)}</p>
          </div>
        </a>
        <button class="movie-card__fav" data-fav-btn data-movie-id="${m.id}" aria-label="Favorito">
          <span data-fav-icon>${isFavorite(m.id) ? '❤️' : '🤍'}</span>
        </button>
      </article>
    `).join('');

    slot.innerHTML = '';
    slot.appendChild(grid);
    wireFavorites(movies);
  }

  function wireFavorites(movies) {
    document.querySelectorAll('[data-fav-btn]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-movie-id'));
        const movie = movies.find((m) => Number(m.id) === id);
        if (!movie) return;
        toggleFavorite(movie);
        const icon = btn.querySelector('[data-fav-icon]');
        icon.textContent = isFavorite(id) ? '❤️' : '🤍';
      });
    });
  }

  getTrending()
    .then((data) => {
      if (!data.results?.length) {
        slot.innerHTML = '<p class="text-muted">No hay tendencias disponibles.</p>';
        return;
      }
      renderMovies(data.results.slice(0, 10));
    })
    .catch((err) => {
      console.error(err);
      renderError(err.message || 'No pudimos cargar las tendencias.');
    });
</script>

<style is:global>
  .movie-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 560px) { .movie-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .movie-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1200px) { .movie-grid { grid-template-columns: repeat(5, 1fr); } }

  .movie-card {
    position: relative;
    background-color: transparent;
    transition: transform var(--transition-base);
  }
  .movie-card:hover { transform: translateY(-4px); }
  .movie-card__link { display: block; color: inherit; }
  .movie-card__poster {
    position: relative;
    aspect-ratio: 2 / 3;
    background-color: var(--color-bg-elevated);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--transition-base);
  }
  .movie-card:hover .movie-card__poster {
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--color-primary-soft);
  }
  .movie-card__poster img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 800ms cubic-bezier(0.2, 0, 0.2, 1);
  }
  .movie-card:hover .movie-card__poster img { transform: scale(1.06); }

  .movie-card__rating {
    position: absolute; top: 0.6rem; left: 0.6rem;
    background-color: rgba(17, 13, 8, 0.78); color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem; font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(240, 180, 58, 0.25);
  }

  .movie-card__body {
    padding: 0.75rem 0.25rem 0;
  }

  .movie-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 0.2rem 0;
    color: var(--color-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .movie-card:hover .movie-card__title {
    color: var(--color-primary);
  }

  .movie-card__year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .movie-card__fav {
    position: absolute; top: 0.6rem; right: 0.6rem;
    background-color: rgba(17, 13, 8, 0.78);
    border-radius: 999px;
    width: 34px; height: 34px;
    display: grid; place-items: center;
    font-size: 1rem;
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }
  .movie-card__fav:hover {
    transform: scale(1.1);
    background-color: var(--color-primary);
  }

  .error-inline {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--color-text-muted);
  }
</style>
